# DRISHTI configuration. Copy to .env and fill in.
# .env is gitignored. NEVER commit real keys — v1's were shared in plaintext and
# had to be rotated (docs/CARRIED_FINDINGS.md H8).
#
# Everything is read through drishti/config.py. Nothing else reads os.environ.

# ─── LLM ─────────────────────────────────────────────────────────────────────
# provider: "openrouter" | "gemini" | "anthropic" | "mock"
# "mock" is deterministic and needs no key — use it in tests and offline demos.
DRISHTI_LLM_PROVIDER=openrouter
DRISHTI_OPENROUTER_API_KEY=
DRISHTI_GEMINI_API_KEY=
DRISHTI_ANTHROPIC_API_KEY=
# Optional. Blank uses the provider default, which for openrouter is
# nvidia/nemotron-3-ultra-550b-a55b:free (1M context, supports tools, free).
# That endpoint is not always available - 2 of 5 probe calls returned 502
# 'Service temporarily overloaded'. Fall back to nvidia/nemotron-3.5-lightning:free.
DRISHTI_LLM_MODEL=
# Budgets are asserts, not hopes (00_GUIDING_MAP.md §12).
DRISHTI_LLM_MAX_CALLS_PER_JOB=25
DRISHTI_LLM_MAX_PROMPT_TOKENS=12000
DRISHTI_LLM_CACHE_ENABLED=true
DRISHTI_LLM_CACHE_DIR=.cache/llm

# ─── Storage ─────────────────────────────────────────────────────────────────
DRISHTI_DB_PATH=data/drishti.db
# Ed25519 key for signing evidence nodes. Auto-created on first run if absent.
# v1 left this empty, so keys regenerated per run and chains were not comparable
# across runs (docs/CARRIED_FINDINGS.md H8).
DRISHTI_LEDGER_KEY_PATH=data/ledger_ed25519.key

# ─── Static analysis ─────────────────────────────────────────────────────────
DRISHTI_STATIC_TIMEOUT_S=90
DRISHTI_MOBSF_ENABLED=false
DRISHTI_MOBSF_URL=http://localhost:8000

# ─── Sandbox ─────────────────────────────────────────────────────────────────
# "auto" tries live and falls back to replay if LiveSandboxSource.available() is
# False. Replay is disclosed in the UI from trace metadata, never from a flag.
DRISHTI_SANDBOX_ENABLED=true
DRISHTI_SANDBOX_MODE=auto
DRISHTI_SANDBOX_DURATION_S=120

# ─── GCP lab ─────────────────────────────────────────────────────────────────
# The ONLY place a real sample is executed. A laptop must never set these to a
# reachable detonator and run a sample locally — see CLAUDE.md.
DRISHTI_GCP_PROJECT=
DRISHTI_GCP_ZONE=asia-south1-a
DRISHTI_GCP_DETONATOR_INSTANCE=drishti-detonator
DRISHTI_GCS_CORPUS_BUCKET=
DRISHTI_GCS_ARTIFACTS_BUCKET=
DRISHTI_GCS_MODELS_BUCKET=

# ─── Corpus (training only, never at request time) ───────────────────────────
DRISHTI_ANDROZOO_API_KEY=
DRISHTI_MALWAREBAZAAR_API_KEY=

# ─── Features / feature flags ────────────────────────────────────────────────
DRISHTI_VLM_ENABLED=true
DRISHTI_RAG_ENABLED=false
