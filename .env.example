# Change this before exposing the demo beyond localhost.
DEMO_API_TOKEN=change-this-demo-token
MAX_UPLOAD_BYTES=104857600

# Optional trained model. For Compose, put it under MODEL_HOST_DIR and use a
# container path such as /models/androzoo.joblib.
MODEL_HOST_DIR=./models
TRAINED_MODEL_PATH=
ML_MODEL_VERSION=baseline-synthetic-v1

# Both values are required for live Gemini; otherwise reports say mock.
GEMINI_API_KEY=
GEMINI_MODEL=

# Directory containing independently generated <apk-sha256>.json artifacts.
OBSERVATIONS_HOST_DIR=./observations

# Optional MLflow tracking server; file storage is the local default.
MLFLOW_TRACKING_URI=file:./mlruns
