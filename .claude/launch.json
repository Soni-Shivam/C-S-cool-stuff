{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "drishti.api.main:app", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "ui",
      "runtimeExecutable": "env",
      "runtimeArgs": ["DRISHTI_API_ORIGIN=http://127.0.0.1:8090", "npm", "--prefix", "ui", "run", "dev"],
      "port": 5173
    }
  ]
}
