<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material, no AppCompat: the app carries no support-library
         dependency, so the theme has to come from the platform. -->
    <style name="ShieldTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
