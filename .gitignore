# ─── Samples & malware. Rule #1: no APK enters git. ────────────────────────────
# 00_GUIDING_MAP.md §4 requires this from commit #1, with an allowlist for the
# inert canary only.
*.apk
*.apks
*.xapk
*.dex
# The one APK we author ourselves. Committed as a prebuilt artifact so the demo
# does not require a Java/Gradle toolchain. Note this MUST be outside any ignored
# directory — git cannot re-include a file whose parent directory is excluded,
# which is why the artifact lives in canary/dist/ and not canary/app/build/.
!canary/dist/*.apk
!canary/dist/.gitkeep
data/samples/
# Root-anchored: bare `observations/` also matched data/fixtures/observations/, which
# holds REAL rescued ObservationArtifacts committed on purpose as regression fixtures
# (tests/contract/test_real_observation_artifacts.py). Detonation output lands on the
# sealed VM, never here, so the blanket rule bought nothing and silently excluded the
# one place observation JSON belongs.
/observations/
v1-reference/**/observations/

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*-signing.pub
credentials.json
service-account*.json

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# Root-anchored deliberately: bare `dist/`/`build/` also match canary/dist/ and
# canary/app/build/, and an unanchored `build/` silently un-allowlists the canary.
/dist/
/build/

# ─── Corpus & ML artifacts (large / regenerable / data not code) ──────────────
*.csv
*.csv.gz
*.joblib
*.pkl
*.onnx
*.tflite
# `models/*` not `models/` — a directory pattern excludes the directory itself and
# no `!` rule can re-include anything inside it, so `!models/.gitkeep` would be dead.
models/*
!models/.gitkeep
data/corpus/
androzoo_cache/

# ─── Experiment tracking (v1 left 1.7MB of mlflow state in-tree) ─────────────
mlflow.db
mlruns/

# ─── Runtime output ───────────────────────────────────────────────────────────
logs/
*.log
.cache/
*.pcap
*.sqlite
*.db-wal
*.db-shm
data/drishti.db

# ─── Node / UI ────────────────────────────────────────────────────────────────
node_modules/
ui/dist/
.vite/

# ─── OS / editor litter ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ─── Terraform ────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Gradle (v1 left its build cache in-tree)
.gradle/
canary/app/build/
v1-reference/**/build/

# Local agent worktrees. Never commit their contents.
.worktrees/

# Machine-specific Android SDK path, written by canary/build.sh.
local.properties
