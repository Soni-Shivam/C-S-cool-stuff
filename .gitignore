# ─── Samples & malware. Rule #1: no APK enters git. ────────────────────────────
# 00_GUIDING_MAP.md §4 requires this from commit #1, with an allowlist for the
# inert canary only.
*.apk
*.apks
*.xapk
*.dex
!canary/**/*.apk
data/samples/
observations/

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*-signing.pub
credentials.json
service-account*.json

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ─── Corpus & ML artifacts (large / regenerable / data not code) ──────────────
*.csv
*.csv.gz
*.joblib
*.pkl
*.onnx
*.tflite
models/
!models/.gitkeep
data/corpus/
androzoo_cache/

# ─── Experiment tracking (v1 left 1.7MB of mlflow state in-tree) ─────────────
mlflow.db
mlruns/

# ─── Runtime output ───────────────────────────────────────────────────────────
logs/
*.log
.cache/
*.pcap
*.sqlite
*.db-wal
*.db-shm
data/drishti.db

# ─── Node / UI ────────────────────────────────────────────────────────────────
node_modules/
ui/dist/
.vite/

# ─── OS / editor litter ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ─── Terraform ────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Gradle build cache (v1 left this in-tree)
.gradle/
